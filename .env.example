CANVAS_BASE_URL=https://yourschool.instructure.com

# Authenticate ONE of two ways:

# 1. Personal access token (Canvas: Account -> Settings -> New Access Token)
CANVAS_TOKEN=your_personal_access_token_here

# 2. Or your browser session, filled in for you by:  npm run refresh-cookie
#    (leave CANVAS_TOKEN unset/commented when using this)
# CANVAS_COOKIE='canvas_session=...; _csrf_token=...'
