{
  "name": "canvas-mcp",
  "version": "0.2.0",
  "description": "MCP server for Canvas LMS (student-focused tools).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "canvas-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "refresh-cookie": "python3 scripts/refresh-cookie.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mammoth": "^1.12.2",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
